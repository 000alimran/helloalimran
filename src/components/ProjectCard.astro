---
import type { Project, Placement } from '../lib/projects';

interface Props {
  project: Project;
  number: number;
  page: Placement;
}

const { project, number, page } = Astro.props;
const { data } = project;
const isVenture = data.group === 'venture';
const tag = (page === 'work' && data.workTag) || data.tag;
const summary = (page === 'work' && data.workSummary) || data.summary;
const href = isVenture ? `/work/${project.id}/` : data.website;
const external = !isVenture && !!href;
const label = isVenture
  ? `${data.title}, read overview`
  : href
    ? `${data.title}, visit ${data.domain} (opens in a new tab)`
    : `${data.title}, website coming soon`;
const footer = isVenture ? 'Read overview' : href ? `Visit ${data.domain}` : `${data.domain} · website coming soon`;
// Cards without a link stay focusable so the paper unfold still works from the keyboard.
const Tag = href ? 'a' : 'article';
---
<Tag
  class="venture"
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  tabindex={href ? undefined : 0}
  data-type={data.filter ?? undefined}
  aria-label={label}
><div class="venture-top"><span>{String(number).padStart(2, '0')}</span><span>{tag}</span></div><div class="venture-body"><p class="tiny-label">{data.role}</p><h3>{data.title}</h3><p>{summary}</p></div><div class="venture-footer"><span>{footer}</span><span aria-hidden="true">{href ? '↗' : ''}</span></div></Tag>
