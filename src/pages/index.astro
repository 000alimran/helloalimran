---
import Base from '../layouts/Base.astro';
import ContactBlock from '../components/ContactBlock.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { projectsFor } from '../lib/projects';
import { getCollection } from 'astro:content';

const ventures = await projectsFor('venture', 'home');
const orbit = await projectsFor('orbit', 'home');
const essays = (await getCollection('writing')).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const studies = (await getCollection('research')).sort((a, b) => a.data.order - b.data.order);
const personLd = {"@context":"https://schema.org","@type":"Person","name":"Al Imran","url":"https://helloalimran.com/","jobTitle":["Designer","Entrepreneur"],"description":"A designer and entrepreneur exploring human-centered design, digital products, and independent research.","sameAs":["https://github.com/000alimran","https://substack.com/@000alimran"]};
---
<Base title="Design, Technology & Ideas" description="Al Imran is a designer and entrepreneur exploring human-centered digital experiences, technology, and independent research." jsonLd={personLd} paper>
<section class="hero"><div class="wrap"><div class="hero-grid"><div><p class="eyebrow">DESIGNER · ENTREPRENEUR · RESEARCH EXPLORER</p><h1 class="hero-title"><span class="line">Thinking deeply.</span><br><em class="line">Building meaningfully.</em></h1><p class="hero-lede">I'm Al Imran. My work moves between design, digital products, business, and the questions that emerge when technology meets real human needs.</p><div class="hero-actions"><a class="btn" href="/work/">Explore selected work <span aria-hidden="true">↗</span></a><a class="underline-link" href="/research/">Research interests ↗</a></div></div><aside class="hero-aside"><p class="tiny-label">THREE THREADS OF MY WORK</p><ul><li>Human-centered digital experiences</li><li>Building & learning through entrepreneurship</li><li>Emerging technology and accessible services</li></ul><p class="meta" style="margin-top:18px">Based in Bangladesh · <a class="underline-link" href="https://github.com/000alimran" target="_blank" rel="noopener noreferrer">@000alimran</a></p></aside></div><div class="hero-base"><span>Independent thinking / intentional building</span><span>Scroll to explore ↓</span></div></div></section>
<div class="marquee" aria-hidden="true"><div class="marquee-track"><span>Human-centered design</span><i>✦</i><span>Digital products</span><i>✦</i><span>Entrepreneurship</span><i>✦</i><span>HCI research</span><i>✦</i><span>Accessibility</span><i>✦</i><span>Storytelling</span><i>✦</i><span>Bangladesh</span><i>✦</i><span>Human-centered design</span><i>✦</i><span>Digital products</span><i>✦</i><span>Entrepreneurship</span><i>✦</i><span>HCI research</span><i>✦</i><span>Accessibility</span><i>✦</i><span>Storytelling</span><i>✦</i><span>Bangladesh</span><i>✦</i></div></div>
<section class="section tone-sage"><div class="wrap section-grid"><div class="sec-label"><span class="sec-number">01 /</span> ABOUT</div><div class="section-copy"><h2 class="section-title">A career shaped by curiosity, rather than a single title.</h2><p>I started in visual communication and advertising. That work led me to user experience, digital products, entrepreneurship, and a growing interest in research. Each chapter taught me a different way of asking better questions.</p><p>I founded The YOLO Studio to connect creativity with execution. Alongside my professional practice, I continue exploring how thoughtful design can make digital services clearer and more useful.</p><a href="/about/" class="text-link">The longer story ↗</a></div></div></section>
<section class="section"><div class="wrap"><div class="kicker-line"><div><p class="eyebrow">02 / SELECTED WORK</p><h2 class="section-title">Work that crosses disciplines.</h2></div><a class="text-link" href="/work/">All ventures & initiatives ↗</a></div><div class="ventures">
{ventures.map((p, i) => <ProjectCard project={p} number={i + 1} page="home" />)}
</div><p class="project-note">I also have connections to other experiments and public-interest work. I keep them separate from my primary ventures, with clear attribution for who initiated each project. <a class="underline-link" href="/work/">Explore the full index ↗</a></p><div class="ventures ventures--three">
{orbit.map((p, i) => <ProjectCard project={p} number={ventures.length + i + 1} page="home" />)}
</div></div></section>
<section class="section tone-dark"><div class="wrap section-grid"><div class="sec-label"><span class="sec-number">03 /</span>RESEARCH</div><div class="section-copy"><h2 class="section-title">Learning to turn practical questions into structured inquiry.</h2><p>I am developing an independent research practice around human-computer interaction, digital accessibility, and technology adoption. I distinguish proposed studies from published findings.</p>{studies.slice(0, 1).map((r) => <div class="paper"><span class="paper-label">{r.data.homeLabel}</span><h3>{r.data.title}</h3><p>{r.data.homeSummary}</p><a href={`/research/${r.id}/`} class="underline-link">Read the research proposal ↗</a></div>)}<a class="text-link" href="/research/">Research index ↗</a></div></div></section>
<section class="section"><div class="wrap section-grid"><div class="sec-label"><span class="sec-number">04 /</span>WRITING</div><div class="section-copy"><h2 class="section-title">Notes from the space between theory and practice.</h2><p>I write to make sense of design, technology, entrepreneurship, and the trade-offs involved in building things that people actually use.</p><div class="simple-list essay-list">{essays.slice(0, 3).map((e) => <a href={`/writing/${e.id}/`}><div class="row-label">{e.data.listLabel}</div><div><strong>{e.data.title}</strong><p>{e.data.homeSummary}</p></div><div class="row-arrow" aria-hidden="true">↗</div></a>)}</div><p class="small muted">You can also follow my writing on <a class="underline-link" href="https://substack.com/@000alimran" target="_blank" rel="noopener noreferrer">Substack ↗</a></p></div></div></section>
<section class="section tone-sky"><div class="wrap section-grid"><div class="sec-label"><span class="sec-number">05 /</span>RIGHT NOW</div><div class="section-copy"><h2 class="section-title">What I'm paying attention to.</h2><p>A living, occasional update about what I am making, studying, and trying to understand, rather than a static résumé.</p><a href="/now/" class="text-link">See my now page ↗</a></div></div></section>
<ContactBlock />
</Base>
