{
  // Build first (`npm run build`), then `wrangler deploy`. The Astro Cloudflare adapter writes the
  // final Worker config to dist/server/wrangler.json and points wrangler at it.
  "name": "helloalimran",
  "compatibility_date": "2026-10-27",
  // Needed for `wrangler preview`, which Cloudflare runs for non-main branch builds.
  "previews": {},
  "assets": {
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    // Without this, page navigations to the admin get the 404 page before the Worker runs.
    "run_worker_first": ["/keystatic", "/keystatic/*", "/api/keystatic/*"]
  }
}
